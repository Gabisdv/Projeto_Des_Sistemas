@startuml
left to right direction

actor "Cliente" as Cliente
actor "Funcionário da Entrada" as Funcionario
actor "Operadora de Cartão" as Cartao

rectangle "Aplicativo de Cinema" {

    usecase "Ver filmes em cartaz" as UC1
    usecase "Consultar horários das sessões" as UC2
    usecase "Comprar ingresso" as UC3
    usecase "Realizar pagamento com cartão" as UC4
    usecase "Gerar QR Code do ingresso" as UC5
    usecase "Validar ingresso" as UC6
    usecase "Ler QR Code" as UC7
}

Cliente --> UC1
Cliente --> UC2
Cliente --> UC3

UC3 ..> UC4 : <<include>>
UC3 ..> UC5 : <<include>>

Cartao --> UC4

Funcionario --> UC6
UC6 ..> UC7 : <<include>>

@enduml
